# ─────────────────────────────────────────────────────────────
# MKCGSPANDAN backend — example environment file
# Copy to backend/.env and fill in real values locally.
# NEVER commit backend/.env or real credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mkcgspandan

# Secret used to sign session JWTs and derive CSRF tokens.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_DAYS=7

# Origin(s) of the Next.js frontend. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:3000

# Session cookie settings
COOKIE_NAME=mkcg_session
# COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production and false otherwise
# COOKIE_SECURE=true

# How many reverse-proxy hops to trust for client IPs (rate limiting).
# "loopback" suits local development behind the Next.js proxy.
TRUST_PROXY=loopback

# Initial administrator (used ONLY by `npm run admin:create`)
ADMIN_NAME=Community Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+910000000000
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Secret key that must be entered on /admin-register (POST /api/v1/admin-register).
# At least 16 characters. Leave empty to switch admin registration off.
# Anyone who knows this key can create an administrator — keep it private.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_REGISTER_KEY=

# Cloudinary (all media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=mkcgspandan

# Upload limits (megabytes)
MAX_IMAGE_MB=8
MAX_VIDEO_MB=60

# Country calling code assumed for 10-digit phone numbers without a prefix
DEFAULT_COUNTRY_CODE=91

# Keep-alive for Render's free tier, which sleeps after 15 minutes without traffic.
# The server pings its own public /ping URL on a timer. On Render the URL is found
# automatically from RENDER_EXTERNAL_URL; elsewhere set KEEP_ALIVE_URL, or leave both
# unset to switch the pinger off.
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=https://your-api.onrender.com/ping
# KEEP_ALIVE_INTERVAL_MINUTES=10

# Community time zone for "today" (birthdays). Keep equal to the website's NEXT_PUBLIC_TIME_ZONE.
# TIME_ZONE=Asia/Kolkata

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# Background jobs (event reminders, orphan upload cleanup). Set to false on
# all but one instance if you run several API processes.
JOBS_ENABLED=true

# Rate limits
RATE_LIMIT_GLOBAL_MAX=1500
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_WRITE_MAX=90
RATE_LIMIT_UPLOAD_MAX=40
# Chat messages one member may send per minute (REST and Socket.IO together)
RATE_LIMIT_CHAT_MAX=60
