# ─────────────────────────────────────────────────────────────
# MKCGSPANDAN frontend — example environment file
# Copy to frontend/.env.local. Nothing here is secret: never put
# API keys or passwords in a NEXT_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────

# Where the Express API runs (origin only — /api/v1 is added automatically).
# Used on the server only, never sent to the browser as an address:
#  - to proxy browser requests from /api/v1/* (see next.config.mjs)
#  - for server-side rendering of public pages
# Resolved in src/lib/api-config.mjs. When unset:
#  - next build / next start / Vercel → https://mkcg-spandan.onrender.com
#  - next dev                         → the development default in api-config.mjs
# A Vercel build refuses a localhost value. NEXT_PUBLIC_API_URL is accepted as
# an alias for the same setting; BACKEND_URL wins if both are set.
#
# Production (Vercel project settings):
# BACKEND_URL=https://mkcg-spandan.onrender.com
# Local development against a local API:
# BACKEND_URL=http://localhost:5000

# Public address of this website (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone used to display dates (IANA name). Defaults to Asia/Kolkata.
# NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata

# Alias of BACKEND_URL (see above). The browser always calls this website's own
# /api/v1, so the session cookie stays first-party and no CORS is involved.
# NEXT_PUBLIC_API_URL=https://mkcg-spandan.onrender.com

# Android app download (the "Download App" button on the homepage hero).
# The full https:// address of the APK file or its download page. Read at build
# time: rebuild after changing it. Leave unset until the APK is published — the
# button then shows "coming soon" and is not a link.
# NEXT_PUBLIC_ANDROID_APK_URL=
